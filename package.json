{
	"name": "nodebb-plugin-post-follow",
	"version": "1.4.1",
	"description": "Follow a single post and get notified when it is edited, deleted or restored, without watching the whole topic.",
	"main": "library.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hershaleh/nodebb-plugin-post-follow.git"
	},
	"keywords": [
		"nodebb",
		"plugin",
		"post",
		"follow",
		"watch",
		"notifications",
		"edit"
	],
	"license": "MIT",
	"nbbpm": {
		"compatibility": "^4.0.0"
	},
	"scripts": {
		"test": "node --test test/logic.test.js test/static.test.js",
		"test:logic": "node --test test/logic.test.js",
		"test:static": "node --test test/static.test.js",
		"test:integration": "node test/integration/run.js",
		"prepublishOnly": "npm test"
	},
	"files": [
		"library.js",
		"plugin.json",
		"public",
		"templates",
		"languages",
		"README.md",
		"README.he.md",
		"LICENSE"
	],
	"bugs": {
		"url": "https://github.com/hershaleh/nodebb-plugin-post-follow/issues"
	},
	"homepage": "https://github.com/hershaleh/nodebb-plugin-post-follow#readme",
	"engines": {
		"node": ">=18"
	}
}
